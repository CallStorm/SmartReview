# SmartReview 部署助手 - 凭据配置模板
# ============================================================
# 用法：
#   1. 复制本文件：  copy deploy.env.example deploy.env
#   2. 用编辑器填入真实密码（deploy.env 已在 .gitignore 中）
#   3. SmartReview 部署助手会在每次部署开始时自动加载 deploy.env
#
# 格式要求：
#   - 每行 KEY=VALUE
#   - = 两侧不要加引号
#   - # 开头的行为注释
#   - 不要有多余空格
# ============================================================

# ---- SSH 凭据（必填，否则助手会停下来报错） ----

# 跳板机（10.73.2.80）root 密码
SSH_BASTION_PASSWORD=

# 目标服务器（10.73.2.21）root 密码
SSH_TARGET_PASSWORD=

# ---- 可覆盖项（有默认值，不填也能跑） ----

# 镜像仓库地址
# DOCKER_REGISTRY=10.72.2.15:80

# 镜像命名空间
# IMAGE_NAMESPACE=review

# 构建代理（仅在 docker build 阶段需要；push 阶段会自动 unset）
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897

# 跳板机
# SSH_BASTION_HOST=10.73.2.80
# SSH_BASTION_USER=root

# 目标服务器
# SSH_TARGET_HOST=10.73.2.21
# SSH_TARGET_USER=root

# 远端 docker-compose 项目目录
# DEPLOY_DIR=/opt/SmartReview-main

# MySQL 备份相关
# MYSQL_CONTAINER=smartreview-main-mysql-1
# MYSQL_USER=root
# MYSQL_PASSWORD=changeme-strong-mysql
# MYSQL_DB=review
